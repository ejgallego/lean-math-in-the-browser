def Bench.fib @&n : tobj :=
  let _x.1 := Nat.log2 n;
  let _x.2 := 2;
  let _x.3 := Nat.add _x.1 _x.2;
  dec _x.1;
  let _x.4 := Bench.fibPair _x.3 n;
  dec _x.3;
  let fst := oproj[0] _x.4;
  inc fst;
  dec[ref] _x.4;
  return fst

def Bench.fibBits @&n : tobj :=
